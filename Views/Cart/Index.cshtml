@model IEnumerable<BookStoreMVC.Models.Cart>

@{
    ViewData["Title"] = "My Cart";
}

<h2 class="fw-bold mb-4">
    Shopping Cart
</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">

        Your cart is empty.

    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>

                <th>Book</th>

                <th>Title</th>

                <th>Price</th>

                <th>Quantity</th>

                <th>Total</th>

                <th width="120">Action</th>

            </tr>

        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td width="100">

                    <img src="@item.Book?.ImageUrl"
                         width="70"
                         height="90"
                         style="object-fit:cover;" />

                </td>

                <td>

                    @item.Book?.Title

                </td>

                <td>

                    ₹@item.Book?.Price

                </td>

                <td>

                    <a asp-action="Decrease"
                    asp-route-id="@item.CartId"
                    class="btn btn-outline-secondary btn-sm">

                        -

                    </a>

                    <span class="mx-2 fw-bold">

                        @item.Quantity

                    </span>

                    <a asp-action="Increase"
                    asp-route-id="@item.CartId"
                    class="btn btn-outline-secondary btn-sm">

                        +

                    </a>

                </td>

                <td>

                    ₹@(item.Quantity * (item.Book?.Price ?? 0))

                </td>

                <td>

                    <a asp-action="Remove"
                       asp-route-id="@item.CartId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Remove this book from cart?');">

                        Remove

                    </a>

                </td>

            </tr>
        }

        </tbody>

    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">

        <h3>

            Grand Total :
            <span class="text-success">
                ₹@Model.Sum(x => x.Quantity * (x.Book?.Price ?? 0))
            </span>

        </h3>

        <form asp-action="Checkout"
            asp-controller="Cart"
            method="post">

            <button type="submit"
                    class="btn btn-success btn-lg">

                Proceed to Checkout

            </button>

        </form>

    </div>
}