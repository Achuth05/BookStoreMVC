@model IEnumerable<BookStoreMVC.Models.Cart>

@{
    ViewData["Title"] = "My Cart";
}

<h2 class="fw-bold mb-4">
    Shopping Cart
</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">

        Your cart is empty.

    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>

                <th>Book</th>

                <th>Title</th>

                <th>Price</th>

                <th>Quantity</th>

                <th>Total</th>

                <th width="120">Action</th>

            </tr>

        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td width="100">

                    <img src="@item.Book?.ImageUrl"
                         width="70"
                         height="90"
                         style="object-fit:cover;" />

                </td>

                <td>

                    @item.Book?.Title

                </td>

                <td>

                    ₹@item.Book?.Price

                </td>

                <td>

                    <a asp-action="Decrease"
                       asp-route-id="@item.CartId"
                       class="btn btn-outline-secondary btn-sm">

                        -

                    </a>

                    <span class="mx-2 fw-bold">

                        @item.Quantity

                    </span>

                    <a asp-action="Increase"
                       asp-route-id="@item.CartId"
                       class="btn btn-outline-secondary btn-sm">

                        +

                    </a>

                </td>

                <td>

                    ₹@(item.Quantity * (item.Book?.Price ?? 0))

                </td>

                <td>

                    <a asp-action="Remove"
                       asp-route-id="@item.CartId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Remove this book from cart?');">

                        Remove

                    </a>

                </td>

            </tr>
        }

        </tbody>

    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">

        <h3>

            Grand Total :
            <span class="text-success">

                ₹@Model.Sum(x => x.Quantity * (x.Book?.Price ?? 0))

            </span>

        </h3>

        <button class="btn btn-success btn-lg"
                data-bs-toggle="modal"
                data-bs-target="#checkoutModal">

            Proceed to Checkout

        </button>

    </div>

    <!-- Checkout Confirmation Modal -->

    <div class="modal fade"
         id="checkoutModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">

                        Confirm Your Order

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">

                    </button>

                </div>

                <div class="modal-body">

                    <div class="text-center mb-3">

                        <h1>🛒</h1>

                        <h5>

                            Review Your Order

                        </h5>

                    </div>

                    <p>

                        You are about to purchase the following items:

                    </p>

                    <ul class="list-group mb-3">

                        @foreach (var item in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between">

                                <span>

                                    @item.Book?.Title
                                    × @item.Quantity

                                </span>

                                <strong>

                                    ₹@(item.Quantity * (item.Book?.Price ?? 0))

                                </strong>

                            </li>
                        }

                    </ul>

                    <h4 class="text-success text-end">

                        Total :
                        ₹@Model.Sum(x => x.Quantity * (x.Book?.Price ?? 0))

                    </h4>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <form asp-action="Checkout"
                          asp-controller="Cart"
                          method="post">

                        <button type="submit"
                                class="btn btn-success">

                            Confirm Order

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}