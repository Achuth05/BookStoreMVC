@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="fw-bold mb-4">

    Admin Dashboard

</h2>

<div class="row">

    <div class="col-md-3 mb-4">

        <div class="card shadow border-0 bg-primary text-white">

            <div class="card-body text-center">

                <h1>📚</h1>

                <h2>@ViewBag.TotalBooks</h2>

                <h5>Total Books</h5>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card shadow border-0 bg-success text-white">

            <div class="card-body text-center">

                <h1>📂</h1>

                <h2>@ViewBag.TotalCategories</h2>

                <h5>Categories</h5>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card shadow border-0 bg-warning text-dark">

            <div class="card-body text-center">

                <h1>👥</h1>

                <h2>@ViewBag.TotalCustomers</h2>

                <h5>Customers</h5>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card shadow border-0 bg-danger text-white">

            <div class="card-body text-center">

                <h1>🧾</h1>

                <h2>@ViewBag.TotalOrders</h2>

                <h5>Total Orders</h5>

            </div>

        </div>

    </div>

</div>

<div class="row mt-2">

    <div class="col-md-4 mb-4">

        <div class="card shadow">

            <div class="card-body text-center">

                <h3>⏳</h3>

                <h2>@ViewBag.PendingOrders</h2>

                <h5>Pending Orders</h5>

            </div>

        </div>

    </div>

    <div class="col-md-4 mb-4">

        <div class="card shadow">

            <div class="card-body text-center">

                <h3>✅</h3>

                <h2>@ViewBag.DeliveredOrders</h2>

                <h5>Delivered Orders</h5>

            </div>

        </div>

    </div>

    <div class="col-md-4 mb-4">

        <div class="card shadow">

            <div class="card-body text-center">

                <h3>💰</h3>

                <h2>₹@ViewBag.TotalRevenue</h2>

                <h5>Total Revenue</h5>

            </div>

        </div>

    </div>

</div>

<hr />

<h4 class="mb-3">

    Quick Actions

</h4>

<div class="d-flex gap-3">

    <a asp-action="Books"
       class="btn btn-primary">

        Manage Books

    </a>

    <a asp-action="Categories"
       class="btn btn-success">

        Categories

    </a>

    <a asp-action="ManageOrders"
       class="btn btn-warning">

        Orders

    </a>

</div>