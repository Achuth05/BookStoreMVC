@{
    ViewData["Title"] = "Categories";
}

<h2 class="fw-bold mb-5">

Browse Categories

</h2>

<div class="row">

    <div class="col-md-3 mb-4">

        <div class="card text-center shadow h-100">

            <div class="card-body">

                <i class="bi bi-laptop display-3 text-primary"></i>

                <h4 class="mt-3">
                    Programming
                </h4>

                <p class="text-muted">

                    Coding, Software Engineering,
                    Web Development

                </p>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card text-center shadow h-100">

            <div class="card-body">

                <i class="bi bi-book display-3 text-success"></i>

                <h4 class="mt-3">
                    Fiction
                </h4>

                <p class="text-muted">

                    Novels, Mystery,
                    Thriller

                </p>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card text-center shadow h-100">

            <div class="card-body">

                <i class="bi bi-globe display-3 text-danger"></i>

                <h4 class="mt-3">
                    History
                </h4>

                <p class="text-muted">

                    World History,
                    Biographies

                </p>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-4">

        <div class="card text-center shadow h-100">

            <div class="card-body">

                <i class="bi bi-lightbulb display-3 text-warning"></i>

                <h4 class="mt-3">
                    Self Help
                </h4>

                <p class="text-muted">

                    Motivation,
                    Productivity

                </p>

            </div>

        </div>

    </div>

</div>