@{
    ViewData["Title"] = "Contact";
}

<h2 class="fw-bold mb-4">

Contact Us

</h2>

<div class="row">

    <div class="col-md-6">

        <form>

            <div class="mb-3">

                <label class="form-label">

                    Full Name

                </label>

                <input class="form-control">

            </div>

            <div class="mb-3">

                <label class="form-label">

                    Email

                </label>

                <input type="email"
                       class="form-control">

            </div>

            <div class="mb-3">

                <label class="form-label">

                    Subject

                </label>

                <input class="form-control">

            </div>

            <div class="mb-3">

                <label class="form-label">

                    Message

                </label>

                <textarea rows="5"
                          class="form-control"></textarea>

            </div>

            <button class="btn btn-primary">

                Send Message

            </button>

        </form>

    </div>

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-body">

                <h4>

                    BookStore

                </h4>

                <hr>

                <p>

                    📍 Kochi, Kerala

                </p>

                <p>

                    📧 bookstore@gmail.com

                </p>

                <p>

                    📞 +91 9876543210

                </p>

                <p>

                    🕒 Mon - Sat

                    9 AM - 8 PM

                </p>

            </div>

        </div>

    </div>

</div>