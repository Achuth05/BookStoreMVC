@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->

<div class="bg-primary text-white rounded p-5 mb-5">

    <div class="row align-items-center">

        <div class="col-lg-6">

            <h1 class="display-4 fw-bold">
                Find Your Next Favourite Book
            </h1>

            <p class="lead mt-3">
                Discover thousands of books across every category.
                Read. Learn. Grow.
            </p>

            <a asp-controller="Book"
               asp-action="Index"
               class="btn btn-warning btn-lg me-3">

                Shop Now

            </a>

            <a asp-controller="Book"
               asp-action="Categories"
               class="btn btn-outline-light btn-lg">

                Browse Categories

            </a>

        </div>

        <div class="col-lg-6 text-center">

            <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=700"
                 class="img-fluid rounded shadow"
                 alt="Books">

        </div>

    </div>

</div>

<h2 class="mb-4 fw-bold">

    Featured Books

</h2>

<div class="row">

    @for(int i=1;i<=4;i++)
    {
        <div class="col-md-3 mb-4">

            <div class="card shadow h-100">

                <img src="https://picsum.photos/300/400?random=@i"
                     class="card-img-top">

                <div class="card-body">

                    <h5 class="card-title">

                        Sample Book @i

                    </h5>

                    <p>

                        Author Name

                    </p>

                    <h4 class="text-primary">

                        ₹599

                    </h4>

                    <a class="btn btn-primary w-100">

                        View Details

                    </a>

                </div>

            </div>

        </div>
    }

</div>

<h2 class="mt-5 mb-4 fw-bold">

    Categories

</h2>

<div class="row text-center">

    <div class="col-md-3">

        <div class="card p-4 shadow">

            💻

            <h4 class="mt-3">

                Programming

            </h4>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card p-4 shadow">

            📚

            <h4 class="mt-3">

                Fiction

            </h4>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card p-4 shadow">

            🔬

            <h4 class="mt-3">

                Science

            </h4>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card p-4 shadow">

            🌍

            <h4 class="mt-3">

                History

            </h4>

        </div>

    </div>

</div>

<h2 class="mt-5 mb-4 fw-bold">

    Why Choose Us?

</h2>

<div class="row text-center">

    <div class="col-md-3">

        <h1>🚚</h1>

        <h4>Fast Delivery</h4>

    </div>

    <div class="col-md-3">

        <h1>💰</h1>

        <h4>Affordable Prices</h4>

    </div>

    <div class="col-md-3">

        <h1>📖</h1>

        <h4>Huge Collection</h4>

    </div>

    <div class="col-md-3">

        <h1>⭐</h1>

        <h4>Quality Books</h4>

    </div>

</div>