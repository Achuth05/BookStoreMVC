@model IEnumerable<BookStoreMVC.Models.Book>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->

<div class="bg-primary text-white rounded p-5 mb-5">

    <div class="row align-items-center">

        <div class="col-lg-6">

            <h1 class="display-4 fw-bold">
                Find Your Next Favourite Book
            </h1>

            <p class="lead mt-3">
                Discover thousands of books across every category.
                Read. Learn. Grow.
            </p>

            <a asp-controller="Book"
               asp-action="Index"
               class="btn btn-warning btn-lg me-3">

                Shop Now

            </a>

            <a asp-controller="Book"
               asp-action="Categories"
               class="btn btn-outline-light btn-lg">

                Browse Categories

            </a>

        </div>

        <div class="col-lg-6 text-center">

            <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=700"
                 class="img-fluid rounded shadow"
                 alt="Books">

        </div>

    </div>

</div>

<div class="text-center mb-4">

    <h2 class="fw-bold">
        Featured Books
    </h2>

    <p class="text-muted">
        Explore our latest and most popular books.
    </p>

</div>
<div class="row">

    @foreach (var book in Model)
    {
        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card shadow h-100">

                <img src="@book.ImageUrl"
                    class="card-img-top"
                    style="height:320px;object-fit:cover;" />

                <div class="card-body">

                    <h5>@book.Title</h5>

                    <p class="text-muted">@book.Author</p>

                    <h5 class="text-primary">
                        ₹@book.Price
                    </h5>

                </div>

                <div class="card-footer bg-white">

                    <a asp-controller="Book"
                    asp-action="Details"
                    asp-route-id="@book.BookId"
                    class="btn btn-primary w-100">

                        View Details

                    </a>

                </div>

            </div>

        </div>
    }

</div>

<h2 class="mt-5 mb-4 fw-bold">

    Categories

</h2>

<div class="row text-center">

    <div class="col-md-3">

        <div class="card p-4 shadow">

            💻

            <h4 class="mt-3">

                Programming

            </h4>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card p-4 shadow">

            📚

            <h4 class="mt-3">

                Fiction

            </h4>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card p-4 shadow">

            🔬

            <h4 class="mt-3">

                Science

            </h4>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card p-4 shadow">

            🌍

            <h4 class="mt-3">

                History

            </h4>

        </div>

    </div>

</div>

<h2 class="mt-5 mb-4 fw-bold">

    Why Choose Us?

</h2>

<div class="row text-center">

    <div class="col-md-3">

        <h1>🚚</h1>

        <h4>Fast Delivery</h4>

    </div>

    <div class="col-md-3">

        <h1>💰</h1>

        <h4>Affordable Prices</h4>

    </div>

    <div class="col-md-3">

        <h1>📖</h1>

        <h4>Huge Collection</h4>

    </div>

    <div class="col-md-3">

        <h1>⭐</h1>

        <h4>Quality Books</h4>

    </div>

</div>