@{
    ViewData["Title"] = "About";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            About BookStore
        </h1>

        <p class="lead text-muted">
            Bringing readers and books together through a simple and modern online bookstore.
        </p>

    </div>

    <div class="row align-items-center mb-5">

        <div class="col-lg-6">

            <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=900"
                 class="img-fluid rounded shadow"
                 alt="Book Store" />

        </div>

        <div class="col-lg-6">

            <h3 class="fw-bold mb-3">
                Our Story
            </h3>

            <p class="text-muted">

                BookStore was created to make discovering and purchasing books
                simple, convenient and enjoyable. Whether you're a student,
                professional or passionate reader, we aim to provide an extensive
                collection of quality books at affordable prices.

            </p>

        </div>

    </div>

    <div class="row text-center mb-5">

        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body">

                    <h1>🎯</h1>

                    <h4>Our Mission</h4>

                    <p class="text-muted">

                        To make quality books easily accessible to everyone through
                        a secure and user-friendly platform.

                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body">

                    <h1>📚</h1>

                    <h4>Huge Collection</h4>

                    <p class="text-muted">

                        Programming, Fiction, Science, History and many more
                        categories in one place.

                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body">

                    <h1>🚚</h1>

                    <h4>Fast Delivery</h4>

                    <p class="text-muted">

                        Reliable order processing with secure checkout and timely
                        delivery.

                    </p>

                </div>

            </div>

        </div>

    </div>

    <div class="bg-light rounded p-5">

        <h3 class="fw-bold mb-4">

            Technologies Used

        </h3>

        <div class="row">

            <div class="col-md-6">

                <ul class="list-group">

                    <li class="list-group-item">
                        ASP.NET Core MVC
                    </li>

                    <li class="list-group-item">
                        Entity Framework Core
                    </li>

                    <li class="list-group-item">
                        MySQL
                    </li>

                </ul>

            </div>

            <div class="col-md-6">

                <ul class="list-group">

                    <li class="list-group-item">
                        Bootstrap 5
                    </li>

                    <li class="list-group-item">
                        Razor Views
                    </li>

                    <li class="list-group-item">
                        Session-based Authentication
                    </li>

                </ul>

            </div>

        </div>

    </div>

</div>