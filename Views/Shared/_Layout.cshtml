<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - BookStore</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
          rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">

                📚 BookStore

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <!-- Left Menu -->
                <ul class="navbar-nav me-auto">

                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="Books">
                                Manage Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="ManageOrders">
                                Manage Orders
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Book"
                               asp-action="Index">
                                Books
                            </a>
                        </li>

                        @if (Context.Session.GetString("Role") == "Customer")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="Order"
                                asp-action="MyOrders">
                                    My Orders
                                </a>
                            </li>
                        }
                    }

                </ul>

                <!-- Search -->
                <form class="d-flex me-3">

                    <input class="form-control me-2"
                           type="search"
                           placeholder="Search books">

                    <button class="btn btn-light"
                            type="submit">

                        <i class="bi bi-search"></i>

                    </button>

                </form>
                @if (Context.Session.GetString("Role") == "Customer")
                {
                    <a class="btn btn-outline-light me-3 position-relative"
                    asp-controller="Cart"
                    asp-action="Index">

                        <i class="bi bi-cart3"></i>

                        Cart

                        @if (ViewBag.CartCount != null && (int)ViewBag.CartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                style="font-size:0.7rem;">

                                @ViewBag.CartCount

                            </span>
                        }

                    </a>
                }
                <!-- Right Menu -->
                <ul class="navbar-nav">

                    @if (Context.Session.GetString("UserName") == null)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">

                                Login

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Register">

                                Register

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">

                            <span class="nav-link text-white">

                                Hello,
                                <strong>@Context.Session.GetString("UserName")</strong>

                            </span>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Logout">

                                Logout

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <div class="container mt-4">

        @RenderBody()

    </div>

    <partial name="_Footer" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>